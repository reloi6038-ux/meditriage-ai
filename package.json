{
    "name":  "meditriage-ai",
    "version":  "1.0.0",
    "description":  "Community health symptom triage \u0026 risk stratification (decision-support, not diagnosis).",
    "main":  "server.js",
    "engines":  {
                    "node":  "\u003e=18.0.0"
                },
    "scripts":  {
                    "start":  "node server.js",
                    "dev":  "nodemon server.js",
                    "test":  "jest --runInBand",
                    "evaluate":  "node evaluation/runEvaluation.js",
                    "seed:admin":  "node scripts/seedAdmin.js",
                    "seed:resources":  "node scripts/seedResources.js",
                    "test:email":  "node scripts/testEmail.js"
                },
    "dependencies":  {
                         "bcryptjs":  "^3.0.3",
                         "compression":  "^1.7.4",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.19.2",
                         "express-rate-limit":  "^7.4.0",
                         "helmet":  "^7.1.0",
                         "joi":  "^17.13.3",
                         "jsonwebtoken":  "^9.0.3",
                         "mongoose":  "^8.6.0",
                         "morgan":  "^1.10.0",
                         "nodemailer":  "^10.6.0"
                     },
    "devDependencies":  {
                            "jest":  "^29.7.0",
                            "mongodb-memory-server":  "^11.3.0",
                            "nodemon":  "^3.1.4",
                            "supertest":  "^7.0.0"
                        },
    "license":  "MIT",
    "jest":  {
                 "testEnvironment":  "node",
                 "testTimeout":  30000,
                 "globalSetup":  "\u003crootDir\u003e/tests/setup.js",
                 "testPathIgnorePatterns":  [
                                                "/node_modules/",
                                                "/tests/setup.js"
                                            ],
                 "forceExit":  true,
                 "detectOpenHandles":  false
             }
}