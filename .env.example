PORT=3000
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/meditriage
NODE_ENV=development
RATE_MAX=120

# Auth — set a long random value in production
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin bootstrap — only used by `npm run seed:admin`
ADMIN_EMAIL=admin@meditriage.dev
ADMIN_PASSWORD=ChangeMe2025!

# --- Email / SMTP (for password reset delivery) ---
# Any SMTP provider works: Gmail, SendGrid, Mailgun, Resend, Postmark, AWS SES, Ethereal.
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# SendGrid: SMTP_USER=apikey, SMTP_PASS=<your-api-key>
# Resend:   SMTP_USER=resend, SMTP_PASS=<your-api-key>
# Leave SMTP_* blank to skip email (dev mode returns the reset token in the API response)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediTriage AI <no-reply@yourdomain.com>"

# Base URL used in reset links — set to your public domain in production
APP_BASE_URL=http://localhost:3000